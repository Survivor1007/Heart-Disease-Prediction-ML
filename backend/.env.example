# Environment Configuration
ENVIRONMENT=development
PROJECT_NAME="Heart Disease Clinical Decision Support System"
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# Database Configuration (Neon DB / PostgreSQL or SQLite Fallback)
# Neon DB Pooled format: postgresql+asyncpg://<user>:<password>@<endpoint>-pooler.us-east-2.aws.neon.tech/<dbname>?ssl=require
DATABASE_URL=sqlite+aiosqlite:///./heart_disease.db

# ML Artifacts Directory Path
MODEL_ARTIFACTS_DIR=ml/artifacts
