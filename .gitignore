# ============================================================
# CARDIOLENS CDSS - Comprehensive .gitignore
# Python Backend + React/TypeScript Frontend
# ============================================================

# -------------------------
# Python / Backend
# -------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
.tox/
.nox/
.cache/
pip-wheel-metadata/
MANIFEST

# Virtual environments
venv/
.venv/
env/
.env/
ENV/
backend/venv/
backend/.env

# Database files
*.db
*.sqlite
*.sqlite3
heart_disease.db

# ML Artifacts and model weights
backend/ml/artifacts/
*.joblib
*.pkl
*.pickle

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Pytest / testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
nosetests.xml
test-results/

# -------------------------
# Application Logs
# -------------------------
logs/
!backend/logs/
backend/logs/*.log
backend/logs/*.log.*
!backend/logs/.gitkeep
!backend/logs/README.md

# -------------------------
# Environment & Configuration Secrets
# -------------------------
.env
.env.local
.env.*.local
!.env.example
backend/.env
frontend/.env
frontend/.env.local
# Allow example files
!**/.env.example

# -------------------------
# Node / Frontend
# -------------------------
node_modules/
frontend/node_modules/

# Production build
dist/
frontend/dist/
build/
*.tsbuildinfo

# npm / yarn
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json
yarn.lock

# -------------------------
# IDEs / Editors
# -------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# -------------------------
# OS-specific
# -------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# -------------------------
# Miscellaneous
# -------------------------
.cache/
tmp/
temp/
